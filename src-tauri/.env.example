# ============================================
# AI Listen RS - 环境变量配置
# 复制此文件为 .env 并填入你的实际配置
# ============================================

# ---------- SMTP 邮件发送 ----------
# 用于注册/登录时发送邮箱验证码
# 以 QQ 邮箱为例，其他邮箱修改 host/port 即可
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_authorization_code

# ---------- GitHub OAuth ----------
# 在 https://github.com/settings/developers 创建 OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ---------- QQ 互联 OAuth ----------
# 在 https://connect.qq.com 创建应用
QQ_APP_ID=your_qq_app_id
QQ_APP_KEY=your_qq_app_key

# ---------- 微信开放平台 OAuth ----------
# 在 https://open.weixin.qq.com 创建应用
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ---------- 支付宝开放平台 OAuth ----------
# 在 https://open.alipay.com 创建应用
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# ---------- 短信服务（阿里云） ----------
# 在 https://dysms.console.aliyun.com 开通
SMS_ACCESS_KEY_ID=your_access_key_id
SMS_ACCESS_KEY_SECRET=your_access_key_secret
SMS_SIGN_NAME=AIListen
SMS_TEMPLATE_CODE=SMS_123456789
